{
  "expo": {
    "name": "Dasig",
    "slug": "dasig",
    "version": "0.11.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "dasig",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.dasig.bayanihan"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.dasig.bayanihan",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "versionCode": 11
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Dasig uses the camera to scan your group hub's code and to take photos of your work."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6E9"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1071404459109-g0e3ucbmkeg7pfacb09ivffi1s6a6igi"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}

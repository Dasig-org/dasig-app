{
  "expo": {
    "name": "Dasig",
    "slug": "dasig",
    "version": "0.20.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": [
      "dasig",
      "org.dasig.bayanihan"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/icon.png",
      "bundleIdentifier": "org.dasig.bayanihan"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": true,
      "package": "org.dasig.bayanihan",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 21,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "packagingOptions": {
              "exclude": [
                "**/librnllama_v8.so",
                "**/librnllama_jni_v8.so",
                "**/librnllama_v8_2.so",
                "**/librnllama_jni_v8_2.so",
                "**/librnllama_v8_2_i8mm.so",
                "**/librnllama_jni_v8_2_i8mm.so",
                "**/librnllama_v8_2_dotprod_i8mm_hexagon_opencl.so",
                "**/librnllama_jni_v8_2_dotprod_i8mm_hexagon_opencl.so"
              ]
            }
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Dasig uses the camera to scan your group hub's code and to take photos of your work.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6E9"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1071404459109-g0e3ucbmkeg7pfacb09ivffi1s6a6igi"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#F47C26"
        }
      ],
      "llama.rn",
      "./plugins/withoutHexagonAssets"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4ebcb668-3539-4f9b-91f2-03a95aa7c870"
      }
    },
    "owner": "dasigorg"
  }
}

# Local development. On a phone (Expo Go), use your computer's LAN address instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=<from `supabase status`>
EXPO_PUBLIC_BIX_URL=http://127.0.0.1:8787

# Sign in with a Dasig account: the public client ID of the "Dasig Ecosystem (web)" OAuth app on dasig.org's Supabase.
EXPO_PUBLIC_DASIG_CLIENT_ID=
